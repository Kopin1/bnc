---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark';
  size?: 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, class: klass = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-bold uppercase tracking-[0.12em] ' +
  'transition-colors duration-200 no-underline';

const sizes = {
  md: 'px-6 py-3 text-xs',
  lg: 'px-8 py-4 text-sm',
};

const variants = {
  primary: 'bg-gold text-ink hover:bg-gold-soft',
  secondary: 'border border-bone/45 text-bone hover:border-gold hover:text-gold',
  ghost: 'text-gold hover:text-gold-soft underline underline-offset-4 decoration-1',
  dark: 'bg-plum text-cream hover:bg-plum-light',
};

const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a href={href} rel={rel} target={target} class={`${base} ${sizes[size]} ${variants[variant]} ${klass}`}>
  <slot />
</a>
