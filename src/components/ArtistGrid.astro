---
import { teachingArtists } from '../data/artists';
import SectionHeading from './SectionHeading.astro';
import ArtistCard from './ArtistCard.astro';
import ColorKey from './ColorKey.astro';
---

<section id="artists" class="bg-aubergine py-24 md:py-32" data-reveal>
  <div class="shell">
    <SectionHeading
      eyebrow="Line-up"
      title="Artists & teachers"
      lede="Instructors from Barcelona, Cuba, Peru, Oslo and Stockholm teaching Bachata and Salsa Cubana all weekend."
    />

    <ColorKey showLevels={false} class="mt-9" />

    <!-- Every artist gets the same card: 4 across on desktop, 2 on mobile, so
         the current eight fill every row. -->
    <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {teachingArtists.map((artist, i) => <ArtistCard artist={artist} eager={i < 4} />)}
    </div>
  </div>
</section>
