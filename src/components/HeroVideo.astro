---
import { event } from '../data/event';
import Button from './Button.astro';

const { heroVideo } = event;
---

<section class="relative isolate flex min-h-[88svh] items-center overflow-hidden bg-aubergine">
  <!-- Layer 1 — brand light. This is the background before the video plays,
       and it still reads well behind it. -->
  <div
    class="absolute inset-0 -z-30"
    style="background:
      radial-gradient(120% 90% at 78% 28%, #5c1442 0%, #2a0a21 46%, #140412 100%),
      linear-gradient(#140412, #140412);"
    aria-hidden="true"
  >
  </div>

  {
    /* Layer 2 — the footage, at every screen size. There is no `src` in the
       markup: the sources are attached by the script below so that visitors
       who ask for reduced motion (or whose browser reports Save-Data) never
       fetch it at all. With no source attached the element renders `poster`,
       which is exactly the fallback those visitors should get. */
    heroVideo.enabled && (
      <video
        class="absolute inset-0 -z-20 h-full w-full object-cover opacity-0 transition-opacity duration-1000 [&.is-playing]:opacity-[0.72]"
        muted
        loop
        playsinline
        preload="none"
        poster={heroVideo.poster}
        aria-hidden="true"
        data-hero-video
        data-sources={JSON.stringify(heroVideo.sources)}
      />
    )
  }

  <!-- Layer 3 — legibility scrim. Always present, so copy contrast never
       depends on what the video happens to be showing at that moment. -->
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(16,3,16,0.88)_0%,rgba(16,3,16,0.68)_45%,rgba(16,3,16,0.34)_100%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-[linear-gradient(to_bottom,transparent,#100310)]"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative w-full py-20 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="eyebrow">
          {event.city}, {event.country}
        </p>

        <h1 class="mt-5 text-[clamp(2.75rem,7.6vw,6.25rem)] uppercase text-bone">
          Bachata &amp;<br />
          <span class="text-gold">Cuban Weekend</span>
        </h1>

        <p
          class="mt-7 inline-block border-y border-gold/40 py-3 font-display text-[clamp(1.25rem,3.6vw,2rem)] uppercase tracking-[0.04em] text-bone"
        >
          {event.dateLabel}
        </p>

        <p class="mt-7 max-w-lg text-lg leading-relaxed text-bone/85 md:text-xl">
          {event.tagline}
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <Button href={event.bookingUrl} external size="lg">Book now</Button>
          <Button href="#the-weekend" variant="secondary" size="lg">Explore the weekend</Button>
        </div>
      </div>

      <div class="hidden justify-self-center lg:block">
        <img
          src="/images/brand/bnc-logo.png"
          alt=""
          width="677"
          height="725"
          class="w-full max-w-[22rem] drop-shadow-[0_0_60px_rgba(247,190,73,0.28)]"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (video) {
    const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Save-Data is the visitor's own explicit request to conserve data, so it
    // is honoured; they still get the poster frame.
    const saveData = (navigator as any).connection?.saveData === true;

    if (motionOk && !saveData) {
      for (const s of JSON.parse(video.dataset.sources ?? '[]')) {
        const el = document.createElement('source');
        el.src = s.src;
        el.type = s.type;
        video.appendChild(el);
      }
      // Fade in only once there are frames to show, so there is no flash of
      // black between the poster and the first painted frame.
      video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
      video.load();
      video.play().catch(() => {
        /* Autoplay refused — the poster and gradient still stand on their own. */
      });
    }
  }
</script>
