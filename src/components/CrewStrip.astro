---
import { Image } from 'astro:assets';
import { crew, crewImage } from '../data/crew';
import SocialIcon from './SocialIcon.astro';
---

{
  crew.length > 0 && (
    <div class="rule-soft mt-16 pt-10">
      <p class="eyebrow">Behind the camera</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-2" role="list">
        {crew.map((member) => {
          const image = crewImage(member.slug);
          return (
            <li class="flex flex-col overflow-hidden bg-aubergine-raised sm:flex-row">
              {image ? (
                <Image
                  src={image}
                  alt={member.name}
                  widths={[240, 360, 480]}
                  sizes="(min-width: 640px) 200px, 100vw"
                  loading="lazy"
                  class="aspect-square w-full object-cover sm:w-48 sm:shrink-0"
                />
              ) : (
                <div class="aspect-square w-full bg-plum sm:w-48 sm:shrink-0" />
              )}
              <div class="flex flex-col justify-center p-5 md:p-6">
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-gold">{member.role}</p>
                <h3 class="mt-2 text-2xl uppercase leading-tight text-bone">{member.name}</h3>
                {member.company && <p class="mt-1 text-sm text-muted">{member.company}</p>}
                {member.blurb && <p class="mt-3 text-sm text-bone/80">{member.blurb}</p>}
                {member.instagram && (
                  <a
                    href={member.instagram.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-flex items-center gap-2 self-start text-sm text-bone no-underline transition-colors hover:text-gold"
                  >
                    <SocialIcon name="instagram" class="h-4 w-4" />
                    {member.instagram.handle}
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  )
}
