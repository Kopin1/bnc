---
import { highlights } from '../data/site';
---

<!-- Deliberately not cards: a hairline-divided strip reads as editorial and
     stays legible at any width. -->
<section class="bg-ink py-14 md:py-16" data-reveal>
  <div class="shell">
    <ul
      class="grid grid-cols-1 gap-px overflow-hidden bg-bone/12 sm:grid-cols-2 lg:grid-cols-3"
      role="list"
    >
      {
        highlights.map((h) => (
          <li class="bg-ink px-5 py-7 md:px-7">
            <p class="font-display text-xl uppercase leading-tight text-gold md:text-2xl">
              {h.label}
            </p>
            <p class="mt-2 text-sm text-muted">{h.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
