---
import { mainPasses, singleTickets, formatPrice, priceConfirmed } from '../data/passes';
import { event } from '../data/event';
import SectionHeading from './SectionHeading.astro';
import PassCard from './PassCard.astro';
---

<!-- The one light section on the page. It breaks up a long dark one-pager and
     makes the conversion block impossible to scroll past. -->
<section id="passes" class="on-light bg-cream py-24 text-plum md:py-32" data-reveal>
  <div class="shell">
    <SectionHeading
      eyebrow="Passes"
      title="Book your weekend"
      lede="One pass for the whole weekend, a single day, or just the party."
      onLight
    />

    <div class="mt-14 grid gap-5 lg:grid-cols-2">
      {mainPasses.map((pass) => <PassCard pass={pass} />)}
    </div>

    <div class="mt-16">
      <h3 class="text-xl uppercase tracking-wide text-plum">Other tickets</h3>

      <!-- Grid rather than flex so the price can move between rows without being
           duplicated in the DOM: on mobile it drops to its own line under the
           name, leaving only Book on the right; from `sm` up all three sit on
           one line. -->
      <ul class="mt-6 divide-y divide-plum/15 border-y border-plum/15" role="list">
        {
          singleTickets.map((t) => (
            <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 gap-y-3 py-5 sm:grid-cols-[minmax(0,1fr)_auto_auto]">
              <div class="min-w-0">
                <p class="font-display text-lg uppercase text-plum">{t.name}</p>
                <p class="text-sm text-plum/70">{t.summary}</p>
              </div>

              <span class="col-start-1 row-start-2 font-display text-xl text-plum sm:col-start-2 sm:row-start-1">
                {formatPrice(t.price)}
              </span>

              <a
                href={event.bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="col-start-2 row-span-2 row-start-1 justify-self-end text-xs font-bold uppercase tracking-[0.14em] text-plum-light underline underline-offset-4 sm:col-start-3 sm:row-span-1"
              >
                Book
              </a>
            </li>
          ))
        }
      </ul>

      {
        !priceConfirmed && (
          <p class="mt-6 max-w-2xl text-sm text-plum/65">
            Prices shown are from the most recent edition and are being confirmed for the next one.
            Booking goes to our Tickster shop.
          </p>
        )
      }
    </div>
  </div>
</section>
