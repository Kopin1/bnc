---
import type { Session } from '../data/schedule';

interface Props {
  session: Session;
  /** Grid cells already show the time in the row header. */
  showTime?: boolean;
  compact?: boolean;
}

const { session, showTime = false, compact = false } = Astro.props;

const levelTone: Record<string, string> = {
  'Open level': 'text-gold',
  Intermediate: 'text-muted',
  Advanced: 'text-pink',
};
---

<div class={`h-full ${compact ? 'py-1' : ''}`}>
  {
    showTime && (
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-gold">
        {session.start}
        {session.end && ` – ${session.end}`}
      </p>
    )
  }

  {
    session.artist && (
      <p class={`${showTime ? 'mt-1.5' : ''} font-display text-sm uppercase leading-tight text-bone`}>
        {session.artist}
      </p>
    )
  }

  <p class={`${session.artist ? 'mt-1' : showTime ? 'mt-1.5' : ''} text-sm leading-snug text-bone/85`}>
    {session.title}
  </p>

  {
    session.level && (
      <p class={`mt-1.5 text-[0.625rem] font-bold uppercase tracking-[0.16em] ${levelTone[session.level] ?? 'text-muted'}`}>
        {session.level}
      </p>
    )
  }

  {session.note && <p class="mt-1.5 text-xs italic text-muted">{session.note}</p>}
</div>
