---
import type { Pass } from '../data/passes';
import { formatPrice, bookingUrlFor, priceOn, tierNote } from '../data/passes';

interface Props { pass: Pass }
const { pass } = Astro.props;
const featured = pass.featured ?? false;
const note = pass.tiers && tierNote(pass.tiers);
---

<article
  data-price-tiers={pass.tiers && JSON.stringify(pass.tiers)}
  class={`flex flex-col p-7 md:p-9 ${
    featured
      ? 'bg-plum text-cream ring-1 ring-plum'
      : 'border border-plum/25 bg-bone text-plum on-light'
  }`}
>
  <div class="flex items-start justify-between gap-4">
    <h3 class={`text-[clamp(2rem,4.4vw,2.8rem)] uppercase ${featured ? 'text-gold' : 'text-plum'}`}>
      {pass.name}
    </h3>
    {
      featured && (
        <span class="shrink-0 bg-gold px-3 py-1 text-[0.625rem] font-bold uppercase tracking-[0.16em] text-ink">
          Most popular
        </span>
      )
    }
  </div>

  <p class={`mt-1 text-sm uppercase tracking-[0.14em] ${featured ? 'text-cream/70' : 'text-plum/70'}`}>
    {pass.summary}
  </p>

  <p class={`mt-7 font-display text-[clamp(2.75rem,6.5vw,4.2rem)] ${featured ? 'text-cream' : 'text-plum'}`}>
    <span data-price>{formatPrice(priceOn(pass))}</span>
  </p>
  {
    pass.tiers && (
      <p data-price-note hidden={!note} class={`mt-2 text-sm ${featured ? 'text-gold' : 'text-plum-light'}`}>
        {note}
      </p>
    )
  }

  <!-- `grow` lets the inclusions list absorb the height difference between
       cards, so both booking buttons line up along the bottom edge. -->
  <ul class={`mt-7 grow space-y-2.5 text-sm ${featured ? 'text-cream/90' : 'text-plum/85'}`} role="list">
    {
      pass.includes.map((item) => (
        <li class="flex gap-3">
          <span class={featured ? 'text-gold' : 'text-plum-light'} aria-hidden="true">
            +
          </span>
          <span>{item}</span>
        </li>
      ))
    }
    {
      pass.excludes?.map((item) => (
        <li class={`flex gap-3 ${featured ? 'text-cream/60' : 'text-plum/60'}`}>
          <span aria-hidden="true">−</span>
          <span>
            {item} <span class="italic">(not included)</span>
          </span>
        </li>
      ))
    }
  </ul>

  <a
    href={bookingUrlFor(pass)}
    target="_blank"
    rel="noopener noreferrer"
    class={`mt-9 inline-flex items-center justify-center px-6 py-4 text-xs font-bold uppercase tracking-[0.14em] no-underline transition-colors ${
      featured ? 'bg-gold text-ink hover:bg-gold-soft' : 'bg-plum text-cream hover:bg-plum-light'
    }`}
  >
    Book {pass.name}<span class="sr-only"> — opens registration in a new tab</span>
  </a>
</article>

<script>
  // The site is static, so the HTML carries the price that applied on the day
  // it was built. Re-pick the tier on the visitor's (Stockholm) date so a price
  // step takes effect on the day, not on the next deploy.
  import { formatPrice, tierOn, tierNote, type PriceTier } from '../data/passes';

  for (const card of document.querySelectorAll<HTMLElement>('[data-price-tiers]')) {
    const tiers: PriceTier[] = JSON.parse(card.dataset.priceTiers!);
    const price = card.querySelector<HTMLElement>('[data-price]');
    const note = card.querySelector<HTMLElement>('[data-price-note]');
    if (price) price.textContent = formatPrice(tierOn(tiers).current.price);
    if (note) {
      const text = tierNote(tiers);
      note.textContent = text ?? '';
      note.hidden = !text;
    }
  }
</script>
